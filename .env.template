# ============================================================================
# FORENSMART ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_RUNONSAVE=true
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_SHOWSTDERREXCEPTIONDETAIL=true

# ============================================================================
# AWS CONFIGURATION
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=forensmart-data
S3_ENCRYPTION=AES256

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/forensmart
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# AI & LLM CONFIGURATION
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================================================
# CONSENT & SECURITY CONFIGURATION
# ============================================================================
CONSENT_SESSION_TIMEOUT=3600
CONSENT_AUDIT_TRAIL_ENABLED=true
CONSENT_REQUIRE_APPROVAL_LINK=true
CONSENT_APPROVAL_LINK_EXPIRY=3600

# ============================================================================
# EXTRACTION CONFIGURATION
# ============================================================================
EXTRACTION_MAX_RETRIES=3
EXTRACTION_RETRY_DELAY=1
EXTRACTION_TIMEOUT=300
EXTRACTION_BATCH_SIZE=100
EXTRACTION_PARALLEL_WORKERS=4

# ============================================================================
# ANALYSIS CONFIGURATION
# ============================================================================
ANALYSIS_ENABLE_SUSPICIOUS_CLASSIFIER=true
ANALYSIS_ENABLE_LOCATION_INTELLIGENCE=true
ANALYSIS_ENABLE_MEDIA_ANALYZER=true
ANALYSIS_SUSPICIOUS_THRESHOLD=0.5

# ============================================================================
# CLOUD CONFIGURATION
# ============================================================================
CLOUD_SYNC_ENABLED=true
CLOUD_SYNC_INTERVAL=300
CLOUD_BACKUP_ENABLED=true
CLOUD_BACKUP_INTERVAL=86400
CLOUD_BACKUP_RETENTION_DAYS=30

# ============================================================================
# AUTOMATION CONFIGURATION
# ============================================================================
AUTOMATION_ENABLED=true
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_NOTIFICATION_ENABLED=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================================
# ERROR HANDLING CONFIGURATION
# ============================================================================
ERROR_AUTO_FIX_ENABLED=true
ERROR_SILENT_ERROR_DETECTION_ENABLED=true
ERROR_MONITORING_ENABLED=true
ERROR_ALERT_ON_CRITICAL=true

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_ALGORITHM=AES-256
SSL_VERIFY=true
CORS_ORIGINS=*

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@forensmart.com

# ============================================================================
# SMS CONFIGURATION
# ============================================================================
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# ============================================================================
# MONITORING & ALERTS
# ============================================================================
SENTRY_DSN=
MONITORING_ENABLED=true
ALERT_ENABLED=true
ALERT_EMAIL=admin@forensmart.com

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
DEBUG=false
ENVIRONMENT=production
TESTING=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_CLOUD_INTEGRATION=true
FEATURE_AUTOMATION=true
FEATURE_AI_REPORTS=true
FEATURE_REAL_TIME_SYNC=true
FEATURE_APPROVAL_LINKS=true
FEATURE_SILENT_ERROR_DETECTION=true
FEATURE_AUTO_ERROR_FIXING=true
